<?xml version="1.0" encoding="utf-8"?>
<!--
  这个 App 只连用户自己指定的 harness 端点，所以明文白名单是收敛的。

  127.0.0.1 / localhost / 10.0.2.2
      在家插线：adb reverse 把电脑端口映射到手机回环。
  ts.net
      在外：Tailscale。桥接用 tailscale serve 的 TCP 转发模式发布，
      TCP 层没有 TLS，但整条链路已被 WireGuard 端到端加密，
      所以放行明文不会把内容暴露到网络上。
      用 MagicDNS 名字（xxx.ts.net）就够了，它被这条覆盖。

  ★ 想按 tailnet 的 100.x.y.z、或家里局域网的 192.168.x.y 直连的话，
    得把那**个** IP 单独加到下面（Android 的白名单只认域名，不认网段）。

  除此之外一律禁止明文。若将来改用带 TLS 的 serve 模式，
  HTTPS 端点不需要在这里登记。

  注意：XML 注释里不能出现连续两个减号，写命令时要避开。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
